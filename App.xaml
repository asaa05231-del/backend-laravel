<?xml version="1.0" encoding="UTF-8" ?>
<Application xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:svc="clr-namespace:SistemPengirimanApp.Services"
             x:Class="SistemPengirimanApp.App">    
    <Application.Resources>
        <ResourceDictionary>
            <svc:FormatRibuanConverter x:Key="FormatRibuan" />
            <svc:IkonMenuConverter x:Key="IkonMenu" />
            <svc:NullableDateConverter x:Key="NullableDateConverter" />
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="Resources/Styles/Colors.xaml" />
                <ResourceDictionary Source="Resources/Styles/Styles.xaml" />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </Application.Resources>
</Application>
