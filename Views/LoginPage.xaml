<?xml version="1.0" encoding="UTF-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="SistemPengirimanApp.Views.LoginPage"
             Shell.NavBarIsVisible="False"
             BackgroundColor="{StaticResource BiruUtama}">
    <Grid RowDefinitions="*, Auto, *">
        <VerticalStackLayout Grid.Row="1" Padding="30" Spacing="0" VerticalOptions="Center">
            <!-- Logo / Judul App -->
            <VerticalStackLayout Spacing="4" Margin="0,0,0,30">
                <Image Source="app_logo.png" WidthRequest="100" HeightRequest="100" HorizontalOptions="Center" Margin="0,0,0,8" />
                <Label Text="SIGAP" FontSize="26" FontAttributes="Bold"
   TextColor="White" HorizontalOptions="Center" />
                <Label Text="Sistem Input Gaji &amp; Pengiriman" FontSize="13"
       TextColor="#B7C0D8" HorizontalOptions="Center" />
            </VerticalStackLayout>
            <!-- Kartu Form Login -->
            <Border Style="{StaticResource KartuBorder}">
                <VerticalStackLayout Spacing="16">
                    <Label Text="Masuk ke Akun" Style="{StaticResource JudulHalaman}" FontSize="20" />
                    <VerticalStackLayout Spacing="4">
                        <Label Text="Username" Style="{StaticResource LabelKartu}" FontAttributes="Bold" />
                        <Border Padding="12,0" HeightRequest="48" StrokeShape="RoundRectangle 10"
                                Stroke="#E5E7EB" BackgroundColor="{StaticResource AbuLatar}">
                            <Entry x:Name="EntryUsername" Placeholder="Masukkan username" />
                        </Border>
                    </VerticalStackLayout>
                    <VerticalStackLayout Spacing="4">
                        <Label Text="Password" Style="{StaticResource LabelKartu}" FontAttributes="Bold" />
                        <Border Padding="12,0" HeightRequest="48" StrokeShape="RoundRectangle 10"
                                Stroke="#E5E7EB" BackgroundColor="{StaticResource AbuLatar}">
                            <Entry x:Name="EntryPassword" Placeholder="Masukkan password" IsPassword="True" />
                        </Border>
                    </VerticalStackLayout>
                    <Label x:Name="LabelError" TextColor="{StaticResource MerahHapus}" FontSize="13"
                           IsVisible="False" HorizontalOptions="Center" />
                    <Button Text="Masuk" Style="{StaticResource TombolUtama}" Clicked="OnLoginClicked" Margin="0,10,0,0" />
                    <Label Text="Login menggunakan username pegawai"
                           FontSize="11" TextColor="{StaticResource AbuTeks}" HorizontalOptions="Center" />
                </VerticalStackLayout>
            </Border>
        </VerticalStackLayout>
    </Grid>
</ContentPage>